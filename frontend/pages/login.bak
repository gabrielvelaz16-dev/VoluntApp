<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - VoluntApp</title>
</head>
<body>

    <h1>VoluntApp</h1>

    <form id="loginForm">
        <input 
            type="email" 
            id="email" 
            placeholder="Correo electrónico" 
            required
        >

        <br><br>

        <input 
            type="password" 
            id="password" 
            placeholder="Contraseña" 
            required
        >

        <br><br>

        <button type="submit">
            Iniciar Sesión
        </button>
    </form>

    <p id="mensaje"></p>

    <script src="../assets/js/login.js"></script>

</body>
</html>